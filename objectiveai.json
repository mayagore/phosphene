{
  "description": "Design iteration and judgment — invent contrasting design directions, render them across shared states, judge them with a multi-model panel, and refine them on feedback.",
  "mcp": {
    "containerfile": "mcp/Containerfile",
    "port": 8080,
    "postgres": true,
    "development": {
      "caches": [
        "/build/target",
        "/usr/local/cargo/registry",
        "/usr/local/cargo/git"
      ]
    }
  },
  "viewer": {
    "containerfile": "viewer/Containerfile",
    "output": "/dist",
    "tabs": [
      {
        "title": "phosphene",
        "module": "./phosphene.js",
        "styles": [
          "./phosphene.css"
        ]
      }
    ],
    "development": {
      "output": "viewer/dist"
    }
  }
}
